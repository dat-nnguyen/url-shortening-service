# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Connection String (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/urlshortener?sslmode=disable"

# JWT Authentication Secret & Expiration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=1h

# Redis Connection URL (Cache & Rate Limiter)
REDIS_URL=redis://localhost:6379
